{
    "$schema": "http://json-schema.org/draft-07/schema#", 
    "title": "∞ Asset 3.3 schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "_id": {
            "description": "the asset id",
            "type" : "string",
            "minLength": 1
        },
        "_rev": {
            "description": "the revision",
            "type" : "string",
            "minLength": 1
        },
        "apptype": {
            "description": "the task type",
            "type" : "string",
            "minLength": 1
        },
        "appver": {
            "description": "the application version of the task",
            "type" : "string",
            "minLength": 1
        },
        "contents":
        {
            "description": "the task content",
            "type": "array",
            "minItems": 1,
	        "items": {
                "type": "object",
                "description": "Some content of an asset.",
                "additionalProperties": true
	        }
        },
        "creationdate" :
        {
            "description": "the creation date of the task",
            "type" : "string",
            "minLength": 1
        },
        "creationuser" :
        {
            "description": "the creation user of the task",
            "type" : "string",
            "minLength": 1
        },
        "creationusername" :
        {
            "description": "the creation username of the task",
            "type" : "string",
            "minLength": 1
        },
        "desc" :
        {
            "description": "the description of the task",
            "type" : "string"
        },
        "name" :
        {
            "description": "the title of the task",
            "type" : "string",
            "minLength": 1
        },
        "resources":  {
            "description": "the task additional resources",
            "type": "object",
            "additionalProperties": true
        },
        "tags": {
            "description": "the task tags",
            "type": "array",
	        "items": {
                "type": "string",
                "description": "Some tag.",
                "minLength": 1
	        }
        },
        "ts" :
        {
            "description": "the task timestamp",
            "type" : "integer"
        },
        "securitydescriptor": {
            "type": "object",
            "description": "Security descriptor of an asset.",
            "additionalProperties": false,
            "properties": {
                "frozen": {
                    "description": "Tells if the task is frozen (no modification allowed)",
                    "type" : "boolean"
                },
                "prj": {
                    "type": "string",
                    "description": "Some project name the asset belongs to",
                    "minLength": 1
	            },
                "r": {
                    "description": "the task read credentials",
                    "type": "array",
                    "items": {
                        "type": "string",
                        "description": "a user or a team",
                        "minLength": 2,
                        "pattern" : "^[UT].*$"
                    }
                },
                "rw": {
                    "description": "the task read/write credentials",
                    "type": "array",
                    "items": {
                        "type": "string",
                        "description": "a user or a team",
                        "minLength": 2,
                        "pattern" : "^[UT].*$"
                    }
                }
            },
            "required" : [
                "frozen", "prj", "r", "rw"
            ]
        },
        "type" :
        {
            "description": "the type of the task",
            "type" : "string",
            "minLength": 1
        },
        "ver": {
            "description": "the application version of the task",
            "type" : "string",
            "const": "2.4"
        },
        "revinfo": {
            "type": "object",
            "description": "Revision history of an asset.",
            "additionalProperties": false,
            "properties": {
                "builddate": {
                    "type": "string",
                    "description": "Some date of the build",
                    "minLength": 1
                },
                "buildid": {
                    "description": "the unique identifier of a build",
                    "example": "{48577a06-4733-4510-a49a-ce2202134617}",
                    "type": "string",
                    "minLength": 38,
                    "maxLength": 38,
                    "pattern": "^\\{[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}\\}$"
                },
                "comment": {
                    "type": "string",
                    "description": "A comment"
                },
                "computername": {
                    "type": "string",
                    "description": "A computer name",
                    "minLength": 1
                },
                "id": {
                    "description": "some id",
                    "type" : "string"
                },
                "rev": {
                    "type": "string",
                    "description": "A revision"
                },
                "savedate": {
                    "type": "string",
                    "description": "A save date",
                    "minLength": 1
                },
                "saveuser": {
                    "type": "string",
                    "description": "A save user",
                    "minLength": 1
                },
                "saveusername": {
                    "type": "string",
                    "description": "A save username",
                    "minLength": 1
                },
                "uncommitedmod":
                {
                    "description": "Tells if the task has uncommitted modifications (useless)",
                    "type" : "boolean"
                },
                "typecommit": {
                    "description": "the task commit type",
                    "type" : "integer"
                },
                "revisionhistory": 
                {
                    "description": "the task revision history",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "description": "A revision item",
                        "additionalProperties": false,
                        "properties" :{
                            "builddate": {
                                "type": "string",
                                "description": "Some date of the build",
                                "minLength": 1
                            },
                            "buildid": {
                                "description": "the unique identifier of a build",
                                "example": "{48577a06-4733-4510-a49a-ce2202134617}",
                                "type": "string",
                                "minLength": 38,
                                "maxLength": 38,
                                "pattern": "^\\{[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}\\}$"
                            },
                            "comment": {
                                "type": "string",
                                "description": "A comment"
                            },
                            "computername": {
                                "type": "string",
                                "description": "A computer name",
                                "minLength": 1
                            },
                            "savedate": {
                                "type": "string",
                                "description": "A save date",
                                "minLength": 1
                            },
                            "saveuser": {
                                "type": "string",
                                "description": "A save user",
                                "minLength": 1
                            },
                            "saveusername": {
                                "type": "string",
                                "description": "A save username",
                                "minLength": 1
                            },
                            "typecommit": {
                                "description": "the task commit type",
                                "type" : "integer"
                            }
                        },
                        "required": [
                            "builddate",  "buildid", "comment", "computername", "savedate", "saveuser", "saveusername", "typecommit"
                        ]
                    }
                }
            },
            "required": [
                "builddate", "buildid", "comment", "computername", "id", "rev", "savedate", "saveuser",
                "saveusername", "uncommitedmod", "typecommit", "revisionhistory"
            ]
        }
    },
    "required": [
        "_id", "_rev", "apptype", "appver", "contents", "creationdate", "creationuser", "creationusername", "desc", "name",
        "resources", "tags", "ts", "securitydescriptor", "type", "ver", "revinfo"
    ]
}
